<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mis gastos"
        android:textSize="26sp" android:padding="16dp" />
    <Button android:id="@+id/btnNuevo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:text="Nuevo gasto" />
    <TextView android:id="@+id/tvResumen" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:text="Cargando gastos…" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/listaGastos" android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingHorizontal="12dp" />
        <TextView android:id="@+id/tvVacio" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="24dp" android:text="Cargando gastos…" />
    </FrameLayout><com.google.android.material.bottomnavigation.BottomNavigationView
    android:id="@+id/navegacion" android:layout_width="match_parent" android:layout_height="wrap_content"
    app:menu="@menu/navegacion" app:labelVisibilityMode="labeled" /></LinearLayout>
