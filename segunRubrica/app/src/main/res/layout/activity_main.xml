<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="24dp">
        <ImageView android:layout_width="100dp" android:layout_height="100dp" android:src="@drawable/logo_gastos"
            android:contentDescription="Logo de Mis gastos" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Mis gastos" android:textSize="30sp" android:gravity="center" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Organiza tus compras y descubre en qué gastas" android:gravity="center" android:paddingVertical="16dp" />
        <Button android:id="@+id/btnCorreo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Acceder o registrarse con correo" />
        <Button android:id="@+id/btnGoogle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Acceder con Google" />
        <Button android:id="@+id/btnFacebook" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Acceder con Facebook" />
        <Button android:id="@+id/btnRecuperar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Recuperar contraseña" />
        <TextView android:id="@+id/tvMensaje" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="16dp" android:gravity="center" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
