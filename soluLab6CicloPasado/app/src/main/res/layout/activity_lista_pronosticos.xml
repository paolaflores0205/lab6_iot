<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:text="Mis pronósticos" android:textSize="26sp" />
    <Button android:id="@+id/btnNuevo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:text="Nuevo pronóstico" />
    <TextView android:id="@+id/tvTotal" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:text="Cargando pronósticos…" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/listaPronosticos" android:layout_width="match_parent"
            android:layout_height="match_parent" android:paddingHorizontal="12dp" />
        <TextView android:id="@+id/tvVacio" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center" android:padding="24dp"
            android:text="Cargando pronósticos…" />
    </FrameLayout>
<com.google.android.material.bottomnavigation.BottomNavigationView
    android:id="@+id/navegacion" android:layout_width="match_parent"
    android:layout_height="wrap_content" app:menu="@menu/navegacion"
    app:labelVisibilityMode="labeled" />
</LinearLayout>
